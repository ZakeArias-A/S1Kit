include README.md
include CONTRIBUTING.md
include uv.lock
recursive-include docs *.md
recursive-include examples *.py *.json *.md *.png *.jpg
recursive-include benchmarks *.py *.json *.md *.csv
recursive-include tests *.py
prune .local
prune runs
prune build
prune dist
global-exclude __pycache__ *.py[cod] .DS_Store
